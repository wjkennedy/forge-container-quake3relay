# Optional host port for local Docker Compose. Cloudflared talks to q3-relay:8080
# on the Compose network, so this only affects direct localhost access.
HOST_PORT=8080

# Tunnel mode used by the launcher: auto, local-managed, or token.
TUNNEL_MODE=auto

# Named Cloudflare tunnel to run. The launcher resolves this by name and validates
# the credentials JSON against it.
CLOUDFLARED_TUNNEL_NAME=q3-websocket

# Optional explicit tunnel ID override. Useful if local cloudflared login state
# cannot resolve the tunnel by name.
# CLOUDFLARED_TUNNEL_ID=00000000-0000-0000-0000-000000000000

# Public hostname exposed through the tunnel.
CLOUDFLARED_PUBLIC_HOSTNAME=q3a.a9group.net

# Origin URL on the Docker network that Cloudflare should forward to.
CLOUDFLARED_ORIGIN_URL=http://q3-relay:8080

# Token refresh behavior for token mode: auto or never.
CLOUDFLARED_TOKEN_REFRESH=auto

# DNS route behavior during prep: auto, always, or never.
CLOUDFLARED_ROUTE_DNS=auto

# Persistent Cloudflare Tunnel token from Zero Trust > Networks > Tunnels.
# Cloudflare may provide either a `cfut_...` token or a long base64-style token.
# Do not commit a real token.
CLOUDFLARED_TOKEN=cfut_replace_with_your_cloudflare_tunnel_token
