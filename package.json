{
  "name": "forge-containers-refapp",
  "version": "1.0.0",
  "license": "ISC",
  "author": "",
  "main": "index.js",
  "scripts": {
    "container:build": "docker build services/quake3-allinone --platform linux/amd64 -t forge-q3-allinone:local",
    "container:run": "docker run --rm --platform linux/amd64 -p 8080:8080 -e SERVER_PORT=8080 --name forge-q3-allinone-local forge-q3-allinone:local",
    "container:up": "docker compose up --build q3-relay",
    "container:up:detached": "docker compose up -d --build q3-relay",
    "container:down": "docker compose down -v",
    "relay:doctor": "bash scripts/q3-relay-admin.sh status",
    "relay:public": "bash scripts/q3-relay-admin.sh public",
    "relay:doctor:all": "bash scripts/q3-relay-admin.sh status-all",
    "relay:assert": "bash scripts/q3-relay-admin.sh assert-forge",
    "relay:assert:public": "bash scripts/q3-relay-admin.sh assert-public",
    "relay:restart": "bash scripts/q3-relay-admin.sh restart",
    "relay:watchdog": "bash scripts/forge-relay-watchdog.sh",
    "relay:supervise": "bash scripts/relay-supervisor.sh",
    "relay:logs": "bash scripts/q3-relay-admin.sh logs",
    "relay:doctor:local": "bash scripts/q3-relay-admin.sh status-local",
    "relay:restart:local": "bash scripts/q3-relay-admin.sh restart-local",
    "forge:restart": "bash scripts/q3-relay-admin.sh restart-forge",
    "forge:demo": "bash scripts/forge-full-demo.sh",
    "container:rcon": "bash scripts/q3-rcon.sh",
    "tunnel:prepare": "bash scripts/prepare-cloudflared-tunnel.sh",
    "tunnel:check-ws": "node scripts/check-relay-websocket.mjs",
    "tunnel:up": "npm run tunnel:quick",
    "tunnel:quick": "docker compose -f docker-compose.yml -f docker-compose.cloudflare.yml up --build q3-relay cloudflared",
    "tunnel:quick:down": "docker compose -f docker-compose.yml -f docker-compose.cloudflare.yml down -v",
    "tunnel:named": "TUNNEL_MODE=token bash start-lan-party.sh",
    "tunnel:named:down": "TUNNEL_MODE=token bash stop-lan-party.sh",
    "tunnel:local-managed": "TUNNEL_MODE=local-managed bash start-lan-party.sh",
    "tunnel:local-managed:down": "TUNNEL_MODE=local-managed bash stop-lan-party.sh",
    "tunnel:down": "npm run tunnel:quick:down",
    "test:e2e:q3": "node tests/e2e/quake3-status.e2e.mjs",
    "test:e2e:container": "bash scripts/test-local-container.sh",
    "test": "npm run test:e2e:container"
  },
  "dependencies": {
    "@forge/api": "^6.1.0",
    "@forge/bridge": "^5.8.0",
    "@forge/react": "^11.2.6",
    "@forge/resolver": "^1.6.16",
    "@forge/sql": "^3.0.0",
    "ws": "^8.17.1"
  }
}
